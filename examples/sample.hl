section .data:
  name: "Engine_Temp"

section .text:
  fn calculate_temp():
    own r1 = 45
    own r2 = 15

    contract:
      cycles: 4
      on_underflow: "pad_nop"
      on_overflow: "compile_error"
    execute:
      add r1, r2
      mov [port_a], r1

    ref label = &name

    print:
      event: "diagnostic"
      sensor: label
      reading: r1
      status: "stable"

    return r1
