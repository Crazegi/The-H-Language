section .data:
  project_name: "H Flight Data Recorder"
  uncertainty: maybe

section .text:
  import math
  import script
  import gpio
  import uart
  import watchdog
  import timer

  struct SensorFrame:
    altitude: int
    velocity: int
    heading: int
    temp: int

  struct MissionLog:
    frames: int
    anomalies: int
    peak_alt: int
    peak_vel: int

  struct Alert:
    code: string
    severity: int
    timestamp: int

  interrupt fn irq_collision_detect():
    own kill = 0
    mov [fc_port], kill
    return kill

  fn ask_int(prompt, fallback):
    own raw = input(prompt)
    own cleaned = trim(raw)
    if len(cleaned) == 0:
      return fallback
    return to_int(cleaned)

  fn clamp_target_alt(v, max_alt):
    own out = v
    if out < 500:
      out = 500
    if out > max_alt:
      out = max_alt
    return out

  fn telemetry_commit(altitude, velocity):
    own [fc_port]
    own r1 = altitude
    own r2 = velocity

    // Profile-sensitive window: generic=3, avr-like=4, cortex-m0-like=2 for mul+mov
    contract:
      cycles: 3
      on_underflow: "pad_nop"
      on_overflow: "compile_error"
    execute:
      mul r1, r2
      mov [fc_port], r1

    yield [fc_port] to irq_collision_detect:
      mov [fc_port], r1

    return r1

  fn detect_anomaly(altitude, velocity, temp, critical_temp, stall_velocity, max_alt):
    own uncertain_temp = phase(temp >= critical_temp, uncertainty)
    own base_alarm = velocity < stall_velocity or altitude > max_alt
    own final_alarm = collapse(uncertain_temp or base_alarm)
    return final_alarm

  fn main():
    const MAX_ALT = 4000
    const STALL_VELOCITY = 12
    const CRITICAL_TEMP = 95
    const MAX_ANOMALIES = 5

    own mission_id = input("mission id: ")
    own pilot = input("pilot name: ")
    own target_raw = ask_int("target altitude (500..4000): ", 1500)
    own target_alt = clamp_target_alt(target_raw, MAX_ALT)

    own start_ms = now_ms()
    own cwd = script.cwd()
    own args_n = script.args_count()
    own os_name = env("OS")

    own led = gpio.claim("[port_a]")
    unused own led_cfg = gpio.mode(led, "out")
    unused own armed_led = gpio.write(led, 1)

    own bus = uart.new("uart1", 115200)
    own wd = watchdog.new("wd1", 250)
    own clock = timer.new("mission", 1000)
    unused own clock_start = timer.start(clock, 20)

    script.mkdir_all("logs")
    write_text("logs/frames.txt", "")
    write_text("logs/report.txt", format("mission={} pilot={} project={}\n", mission_id, pilot, project_name))

    own frames_ok = 0
    own anomalies = 0
    own peak_alt = 0
    own peak_vel = 0

    for i in 20:
      unused own wd_tick = watchdog.feed(wd)

      own maybe_read = phase(i % 7 == 0, uncertainty)
      if maybe_read == maybe:
        continue

      own altitude = target_alt + (i * 9)
      own velocity = 20 + (i % 15)
      own heading = (i * 17) % 360
      own temp = 62 + (i % 38)

      own frame = SensorFrame(altitude, velocity, heading, temp)
      own alarm = detect_anomaly(frame.altitude, frame.velocity, frame.temp, CRITICAL_TEMP, STALL_VELOCITY, MAX_ALT)

      if frame.altitude > peak_alt:
        peak_alt = frame.altitude
      if frame.velocity > peak_vel:
        peak_vel = frame.velocity

      own health = "nominal"
      if alarm:
        health = "anomaly"
        add anomalies, 1

        own alert = Alert("FLT-ANOM", 2, now_ms())
        own alert_line = format("alert code={} severity={} ts={} i={} alt={} vel={} temp={}\n", alert.code, alert.severity, alert.timestamp, i, frame.altitude, frame.velocity, frame.temp)
        append_text("logs/report.txt", alert_line)
      else:
        if frame.temp > 85:
          health = "warm"

      own commit_value = telemetry_commit(frame.altitude, frame.velocity)
      own frame_line = format("t={} alt={} vel={} hdg={} temp={} status={} commit={}\n", i, frame.altitude, frame.velocity, frame.heading, frame.temp, health, commit_value)
      append_text("logs/frames.txt", frame_line)
      unused own tx = uart.write(bus, frame_line)

      add frames_ok, 1

      if anomalies > MAX_ANOMALIES:
        break

    own mission = MissionLog(frames_ok, anomalies, peak_alt, peak_vel)

    own duration_ms = now_ms() - start_ms
    own status = "nominal"
    if mission.anomalies > 0:
      status = "degraded"

    if mission.anomalies > MAX_ANOMALIES:
      status = "emergency"
      unused own disarm_led = gpio.write(led, 0)
      append_text("logs/report.txt", "emergency landing triggered\n")

      print:
        mission: mission_id
        pilot: pilot
        frames: mission.frames
        anomalies: mission.anomalies
        peak_alt: mission.peak_alt
        peak_vel: mission.peak_vel
        duration_ms: duration_ms
        status: status
        log: "logs/report.txt"
      return -99

    own sort_cmd = "sort logs/frames.txt"
    if contains(os_name, "Windows"):
      sort_cmd = "powershell -NoProfile -Command \"Get-Content logs/frames.txt | Sort-Object\""
    own sorted_lines = script.run_capture_lines(sort_cmd)

    own top = 0
    for line in sorted_lines:
      if len(trim(line)) == 0:
        continue
      add top, 1
      print:
        peak_line: line
      if top == 5:
        break

    own score = mission.frames * 10
    score = score - (mission.anomalies * 25)
    score = score + (mission.peak_alt / 100)
    score = score + mission.peak_vel

    own report = format("mission={} pilot={} target={} frames={} anomalies={} peak_alt={} peak_vel={} duration_ms={} status={} score={} cwd={} args={} os={}\n", mission_id, pilot, target_alt, mission.frames, mission.anomalies, mission.peak_alt, mission.peak_vel, duration_ms, status, score, cwd, args_n, os_name)
    append_text("logs/report.txt", report)

    print:
      mission: mission_id
      pilot: pilot
      frames: mission.frames
      anomalies: mission.anomalies
      peak_alt: mission.peak_alt
      peak_vel: mission.peak_vel
      duration_ms: duration_ms
      status: status
      log: "logs/report.txt"

    return score
