section .data:
  engine_name: "Engine_Temp"
  threshold: 65
  uncertainty: maybe

section .text:
  fn calibrate(base, delta):
    own r9 = base
    add r9, delta
    return r9

  fn main():
    own r1 = 45
    own r2 = 15

    contract:
      cycles: 6
      on_underflow: "pad_nop"
      on_overflow: "compile_error"
    execute:
      add r1, r2
      mul r1, r2
      mov [port_a], r1

    own r3 = calibrate(r1, 5)
    ref label = &engine_name

    if r3 >= threshold:
      print:
        event: "warning"
        sensor: label
        reading: r3
        status: "high"
    else:
      print:
        event: "diagnostic"
        sensor: label
        reading: r3
        status: "stable"

    while r1 < threshold:
      add r1, 2

    repeat 2:
      add r1, 1

    own label_upper = upper(engine_name)
    own has_temp = contains(label_upper, "TEMP")
    own signal = phase(has_temp, uncertainty)

    print:
      label: label_upper
      label_len: len(label_upper)
      signal: signal
      stable_gate: collapse(not signal)

    return r1
